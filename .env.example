# Copy to .env.local for local development. Never commit .env.local.
# All variables are OPTIONAL: without them the stats endpoint silently no-ops.
# Blank values are treated as unset.

# Upstash Redis. The Vercel Marketplace "Upstash for Redis" integration injects
# these KV-compatible names automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# If your integration injected Upstash's own names instead, use these (and
# leave the KV_* pair unset):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Gates GET /api/stats (owner view). Long random string; send it as
# `Authorization: Bearer <token>` (query-string tokens are not accepted).
STATS_ADMIN_TOKEN=

# Recommended in production: secret (>= 32 random chars) that keys the IP
# hash used by the rate limiter, so limits are consistent across serverless
# instances. When unset, each instance uses a private random key instead.
# STATS_RATE_SALT=
